# Modelo de variaveis de ambiente (Aulas 5, 13, 15 e fechamento do projeto).
# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.
#   PowerShell:  Copy-Item .env.example .env
#
# Tudo e opcional: sem valor, o app e os servidores usam o padrao de
# laboratorio. Como conseguir cada chave: docs/CONTAS_E_CHAVES.md
#
# No build do EAS (nuvem) o .env NAO sobe. Os mesmos nomes vao como
# variaveis do projeto no EAS:
#   eas env:create --name GOOGLE_MAPS_API_KEY --value "..." --environment preview
#
# Se uma chave for commitada por engano, apagar do arquivo NAO basta: ela
# continua no historico do Git. Revogue/troque a chave no painel do servico.

# =================== Lidas pelo app.config.js (o APP) ===================

# projectId do EAS (eas init mostra o valor). Sem ele o token de push falha.
EAS_PROJECT_ID=

# Identificador do app (Android package / iOS bundle id). Padrao no
# app.config.js: com.clinicaaura.app. Precisa ser o MESMO do Firebase e da
# restricao da chave do Google Maps.
ANDROID_PACKAGE=

# Firebase (push no Android). Caminho do google-services.json baixado do
# console do Firebase. Vazio = usa ./google-services.json se existir.
GOOGLE_SERVICES_JSON=

# Aula 12 - Google Maps SDK for Android (ADR 003). Chave restrita ao pacote
# do app no Google Cloud Console. (O mapa em si ainda nao foi implementado.)
GOOGLE_MAPS_API_KEY=

# Endereco das APIs locais. No CELULAR FISICO troque pelo IP da sua maquina
# (ipconfig -> Endereco IPv4 do Wi-Fi), ex.: http://192.168.0.15:3000
# No emulador Android: http://10.0.2.2:3000. Vazio = http://localhost:3000/3001
API_URL=
AUTH_API_URL=

# Coordenadas da clinica (graus decimais, ponto ou virgula). Vazio = as de
# src/config/clinica.js (Rua Nove de Julho, 1500, Sao Carlos).
CLINICA_LATITUDE=
CLINICA_LONGITUDE=

# Chaves de teste no aparelho (docs/TESTES_APARELHO.md). Deixe vazio no dia a dia.
# BLUETOOTH_REAL=1   -> Bluetooth de verdade (so em development build)
# BACKGROUND_REAL=1  -> tarefa em background de verdade (so em development build)
# LEMBRETE_TESTE_MINUTOS=1 -> lembrete da consulta 1 min antes, em vez de 60
BLUETOOTH_REAL=
BACKGROUND_REAL=
LEMBRETE_TESTE_MINUTOS=

# ============ Lidas pelos SERVIDORES Node (nunca pelo app) ============
# Os servidores (npm run auth-api / gateway / push) leem este .env sozinhos
# (servidor/carregar-env.js). Variavel do terminal vale mais que o .env.

# Para onde o SMS vai: simulado (padrao, nada sai), twilio ou zenvia.
# twilio e zenvia ENVIAM DE VERDADE e cobram por mensagem.
SMS_PROVEDOR=simulado

# Gateway simulado (servidor/gateway-sms.js). Vazio = chave de laboratorio.
GATEWAY_SMS_KEY=
GATEWAY_SMS_URL=

# Twilio (SMS_PROVEDOR=twilio). Console da Twilio -> Account Info.
# TWILIO_FROM = numero comprado na Twilio, formato +15551234567
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Zenvia (SMS_PROVEDOR=zenvia). Console da Zenvia -> Integracoes -> API.
# ZENVIA_FROM = identificador do remetente cadastrado na Zenvia
ZENVIA_API_TOKEN=
ZENVIA_FROM=

# Push (servidor/enviar-push.js): token de acesso do Expo, so se o projeto
# exigir "enhanced security" para push. expo.dev -> Account -> Access tokens.
EXPO_ACCESS_TOKEN=
