# Modelo de variaveis de ambiente (Aulas 5, 13 e 15).
# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.
# No build do EAS, os mesmos nomes vao como EAS Secrets:
#   eas secret:create --name GOOGLE_MAPS_API_KEY --value "..."
#
# Se uma chave for commitada por engano, apagar do arquivo NAO basta: ela
# continua no historico do Git. Revogue/troque a chave no painel do servico.

# ---- Lidas pelo app.config.js (Aula 15) ----

# projectId do EAS (eas init mostra o valor). Sem ele o token de push falha.
EAS_PROJECT_ID=

# Identificador do app (Android package / iOS bundle id). Padrao no
# app.config.js: com.clinicaaura.app
ANDROID_PACKAGE=

# Aula 12 - Google Maps SDK for Android (ADR 003). Chave restrita ao pacote
# do app no Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# ---- Lidas pelos SERVIDORES (nunca pelo app) ----

# Aula 13 - chave do gateway de SMS (servidor/gateway-sms.js e
# servidor/auth-api.js). Sem valor, vale a chave de laboratorio que os dois
# servidores conhecem. Os servidores leem do ambiente do terminal:
#   PowerShell: $env:GATEWAY_SMS_KEY = "..."; npm run auth-api
GATEWAY_SMS_KEY=
