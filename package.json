{
  "name": "proj-clinica-aura",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api": "json-server --watch db_clinica.json --port 3000",
    "api:rede": "json-server --watch db_clinica.json --port 3000 --host 0.0.0.0",
    "auth-api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON servidor/auth-api.js",
    "gateway": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON servidor/gateway-sms.js",
    "push": "node servidor/enviar-push.js",
    "gerar-consultas": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON servidor/gerar-consultas.js",
    "medir": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/medir-conflitos.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "buffer": "^6.0.3",
    "expo": "~51.0.0",
    "expo-background-fetch": "~12.0.1",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-device": "~6.0.2",
    "expo-file-system": "~17.0.1",
    "expo-image-picker": "~15.1.0",
    "expo-local-authentication": "~14.0.1",
    "expo-location": "~17.0.1",
    "expo-notifications": "~0.28.19",
    "expo-secure-store": "~13.0.1",
    "expo-sms": "~12.0.1",
    "expo-status-bar": "~1.12.1",
    "expo-task-manager": "~11.8.2",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^13.3.3",
    "jest": "^29.4.0",
    "jest-expo": "~51.0.4",
    "react-test-renderer": "18.2.0"
  },
  "private": true
